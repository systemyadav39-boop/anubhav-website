<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Anubhav | Creator</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0f172a;
      color: white;
      text-align: center;
    }

    .container {
      max-width: 700px;
      margin: auto;
      padding: 60px 20px;
    }

    .profile {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ff0000, #7c3aed);
      margin: 0 auto 25px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 45px;
      font-weight: bold;
    }

    h1 {
      font-size: 40px;
      margin-bottom: 10px;
    }

    .tagline {
      color: #cbd5e1;
      font-size: 18px;
      margin-bottom: 30px;
    }

    .card {
      background: #1e293b;
      padding: 25px;
      border-radius: 20px;
      margin-top: 25px;
    }

    .card h2 {
      margin-bottom: 12px;
    }

    .card p {
      color: #cbd5e1;
      line-height: 1.6;
    }

    .youtube {
      display: inline-block;
      margin-top: 25px;
      padding: 15px 28px;
      background: #ff0000;
      color: white;
      text-decoration: none;
      border-radius: 10px;
      font-weight: bold;
    }

    footer {
      margin-top: 50px;
      color: #94a3b8;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="profile">A</div>

    <h1>Anubhav</h1>

    <p class="tagline">
      🎬 Creator | 🤖 AI | YouTube
    </p>

    <div class="card">
      <h2>Welcome to My Website 👋</h2>
      <p>
        Hello! I'm Anubhav, a content creator interested in
        AI, YouTube and creative videos.
      </p>

      <a class="youtube"
         href="https://youtube.com/@aypower18"
         target="_blank">
        ▶ Visit My YouTube
      </a>
    </div>

    <footer>
      © 2026 Anubhav. All Rights Reserved.
    </footer>

  </div>

</body>
</html>
